# WeatherAI API key — format wai_xxx. Server-side ONLY; never expose to the browser.
WEATHER_AI_KEY=wai_your_key_here

# Port the proxy listens on (Render injects its own PORT in production).
PORT=8787

# Comma-separated list of allowed browser origins for CORS.
# Local dev = the Vite dev server; production = your Render Static Site URL.
ALLOWED_ORIGIN=http://localhost:5173

# AI budget threshold: when AI requests remaining drops below this, the proxy
# auto-switches weather calls to ai=false to protect the 200/mo AI quota.
AI_DEGRADE_THRESHOLD=15
