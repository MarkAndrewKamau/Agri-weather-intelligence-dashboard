{
  "name": "agri-weather-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TS proxy layer for the WeatherAI API — keeps the API key server-side.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --target node20",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/cache.test.ts src/rateState.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
